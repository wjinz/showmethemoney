# 빌드 시 PWA 플러그인에서 참조할 Supabase 정보
VITE_SUPABASE_URL=당신의_SUPABASE_URL_이곳에_입력
VITE_SUPABASE_ANON_KEY=당신의_SUPABASE_ANON_KEY_이곳에_입력

# Gemini API KEY (Severless 함수 및 로컬 구동용)
GOOGLE_API_KEY=당신의_GEMINI_API_KEY_이곳에_입력

# Vercel KV 정보 (Vercel 대시보드 Storage 탭에서 Connect 후 자동 생성됨)
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
